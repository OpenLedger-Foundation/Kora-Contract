# packaging/.env.example
# Copy this file to .env at the project root and fill in the contract addresses
# before starting the indexer with Docker Compose or deploy-indexer.sh.
#
# This template mirrors the variables written by deploy-indexer.sh so both
# deployment paths stay in sync.

# ── Network ───────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
# For mainnet use: https://mainnet.sorobanrpc.com
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (used by docker-compose):
DATABASE_URL=postgresql://kora:kora@postgres:5432/kora_indexer
# SQLite (used by systemd / bare-metal):
# DATABASE_URL=sqlite:///opt/kora/services/indexer/indexer.db

# ── Indexer tuning ────────────────────────────────────────────────────────────
START_LEDGER=0
CHECKPOINT_INTERVAL_SECONDS=60
POLL_INTERVAL_MS=1000

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Contract addresses (from deployments/<network>/addresses.json) ───────────
CONTRACT_INVOICE_NFT=
CONTRACT_MARKETPLACE=
CONTRACT_FINANCING_POOL=
CONTRACT_RISK_REGISTRY=
CONTRACT_PRICE_ORACLE=
CONTRACT_GOVERNANCE=
CONTRACT_ACCESS_CONTROL=

# ── Community profile (API + health) ─────────────────────────────────────────
TREASURY_CONTRACT_ID=
# Optional prebuilt indexer image; leave empty to build locally.
KORA_INDEXER_IMAGE=
