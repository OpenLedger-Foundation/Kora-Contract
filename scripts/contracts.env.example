# =============================================================================
# Kora Protocol — Contract Addresses
#
# Copy this file to scripts/contracts.env and fill in the deployed contract IDs.
# The diagnose.sh script will source this file automatically if present.
# This file is intentionally limited to public contract addresses. Do not put
# RPC credentials, keeper keys, API keys, or other secrets here. Production
# services receive secrets from their environment-specific secrets manager;
# local development uses ignored files outside the repository. See
# infra/secrets/README.md.
#
# You can also export these as environment variables directly, or pass them
# as command-line flags to the script (see ./scripts/diagnose.sh --help).
# =============================================================================

INVOICE_NFT_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MARKETPLACE_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
FINANCING_POOL_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TREASURY_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ACCESS_CONTROL_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
RISK_REGISTRY_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
VESTING_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
GOVERNANCE_VOTING_CONTRACT=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA