{
  "name": "@kora-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript client bindings for the Kora Protocol smart contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "release:npm": "npm publish --access public",
    "docs:api": "typedoc"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.12.12",
    "@types/urijs": "^1.19.26",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/transaction-recovery.test.ts",
      "**/tests/clients.test.ts"
    ],
    "collectCoverageFrom": [
      "src/transactionRecovery.ts",
      "src/errorMapping.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
