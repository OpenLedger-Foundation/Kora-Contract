{
  "name": "@kora/governance-sync",
  "version": "1.0.0",
  "description": "Kora Protocol — Governance-to-forum bridge service for proposal sync and discussion",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "better-sqlite3": "9.4.3",
    "dotenv": "16.4.5",
    "pino": "9.1.0",
    "pino-pretty": "11.0.0",
    "axios": "1.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.10",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.4.5",
    "@types/axios": "0.14.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": ["src/metrics.ts"],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 75,
        "functions": 90,
        "statements": 90
      }
    }
  }
}
