{
  "name": "@kora/api-subscriptions",
  "version": "1.0.0",
  "description": "Kora Protocol — SSE subscription service for invoice events (authorized fan-out)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint *.ts __tests__ --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "collectCoverageFrom": ["*.ts"],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 90,
        "functions": 90,
        "statements": 90
      }
    }
  }
}
