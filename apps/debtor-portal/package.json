{
  "name": "@kora/debtor-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Wallet-free, link-based invoice confirmation portal for debtors (debtor_attestation relay flow)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts", "**/tests/**/*.test.tsx"],
    "collectCoverageFrom": ["src/**/*.ts", "src/**/*.tsx"],
    "coverageThreshold": {
      "global": { "branches": 90, "functions": 90, "lines": 90, "statements": 90 }
    }
  }
}
