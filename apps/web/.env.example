# ==============================================================================
# Kora Protocol Web Application — Environment Configuration
# ==============================================================================

# Stellar & Soroban RPC Network Settings
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Offchain Gateway & Indexer Endpoints
NEXT_PUBLIC_GATEWAY_URL=https://api-testnet.kora.finance
NEXT_PUBLIC_INDEXER_API_BASE=https://indexer-testnet.kora.finance
GITHUB_REPO=OpenLedger-Foundation/Kora-Contract

# Deployment Manifest Path (Optional — overrides individual contract IDs if set)
# NEXT_PUBLIC_DEPLOYMENT_MANIFEST=../../deployments/testnet.json

# On-chain Contract IDs (Soroban StrKey Address format: C...)
NEXT_PUBLIC_INVOICE_NFT_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KN
NEXT_PUBLIC_FINANCING_POOL_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KO
NEXT_PUBLIC_TREASURY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KP
NEXT_PUBLIC_RISK_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KQ
NEXT_PUBLIC_ACCESS_CONTROL_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KR
NEXT_PUBLIC_PRICE_ORACLE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KS
