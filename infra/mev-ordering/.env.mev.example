# Kora MEV ordering observation harness — example configuration.
#
# Copy to `.env.mev` (git-ignored) and adjust. Every value shown is the
# built-in default, so an empty file behaves identically.
# See README.md for the full reference and interpretation guidance.

# ── Target ────────────────────────────────────────────────────────────────────
# `mock` (default, offline) or `testnet` (live Soroban RPC).
MEV_MODE=mock

# Environment tag. `production` is refused by the safety guard.
MEV_ENV=staging

# Soroban RPC endpoint used when MEV_MODE=testnet.
MEV_RPC_URL=https://soroban-testnet.stellar.org
MEV_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Source accounts (testnet only) ────────────────────────────────────────────
# Optional comma-separated secret keys. Missing slots are filled with ephemeral
# accounts funded through friendbot, so testnet runs need no secrets at all.
MEV_SOURCE_SECRETS=
MEV_AUTOFUND_ACCOUNTS=true
MEV_FRIENDBOT_URL=

# ── Competition shape ─────────────────────────────────────────────────────────
MEV_ACCOUNTS_PER_ROUND=4
MEV_ROUNDS=3
MEV_BASE_FEE=100
MEV_FEE_STEP=500
MEV_SUBMIT_STAGGER_MS=0

# ── Observation thresholds ────────────────────────────────────────────────────
MEV_OBSERVE_TIMEOUT_MS=30000
MEV_POLL_INTERVAL_MS=1000
# Set true only when deliberately observing a congested ledger; promotes
# fee-priority mismatches from advisory to a hard failure (fee priority only
# binds during surge pricing).
MEV_EXPECT_FEE_PRIORITY=false
MEV_STRICT_ARRIVAL_ORDER=false
MEV_MAX_HARD_DEVIATIONS=0

# ── Output ────────────────────────────────────────────────────────────────────
MEV_OUTPUT_DIR=results
LOG_LEVEL=info
