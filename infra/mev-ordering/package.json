{
  "name": "@kora/mev-ordering",
  "version": "1.0.0",
  "description": "Kora Protocol — testnet transaction-ordering observation harness for MEV/surge regression detection",
  "private": true,
  "scripts": {
    "harness": "ts-node src/run.ts",
    "harness:mock": "ts-node src/run.ts --mode=mock",
    "harness:testnet": "ts-node src/run.ts --mode=testnet",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint src tests --ext .ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "dotenv": "16.4.5",
    "pino": "9.1.0",
    "pino-pretty": "11.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": ["**/tests/**/*.test.ts"],
    "globalSetup": "./tests/global-setup.ts",
    "collectCoverageFrom": ["src/**/*.ts"]
  }
}
